Options -Indexes
DirectoryIndex index.php
Require all granted

<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
</IfModule>

<FilesMatch "^\.">
Require all denied
</FilesMatch>

<IfModule LiteSpeed>
    RewriteEngine On
    RewriteCond %{QUERY_STRING} (^|&)op=(step|holistic)(&|$)
    RewriteRule ^api\.php$ - [E=noconntimeout:1]
</IfModule>
